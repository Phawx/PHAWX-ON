#include <winver.h>
#include "version.h"

1 ICON "phawx.ico"
1 24 "phawx.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PH_VER_MAJOR,PH_VER_MINOR,PH_VER_PATCH,0
PRODUCTVERSION PH_VER_MAJOR,PH_VER_MINOR,PH_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Phawx"
      VALUE "FileDescription", "Phawx ON"
      VALUE "FileVersion", PH_VERSION
      VALUE "InternalName", "PhawxON"
      VALUE "OriginalFilename", "PhawxON.exe"
      VALUE "ProductName", "Phawx ON"
      VALUE "ProductVersion", PH_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

#include <winver.h>

/* FileDescription is the name Phawx ON shows for the plugin before it runs */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Phawx"
      VALUE "FileDescription", "ROG Ally"
      VALUE "PhawxWarning", "Sets the operating mode through the ASUS driver that Armoury Crate installs. Armoury Crate may change it back while it runs."
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "rogally"
      VALUE "OriginalFilename", "rogally.dll"
      VALUE "ProductName", "Phawx ON ROG Ally plugin"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

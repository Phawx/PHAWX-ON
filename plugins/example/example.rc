#include <winver.h>

/* FileDescription is the name Phawx ON shows for the plugin before it runs.
   Change these strings (and the file name) for your own plugin: they are what
   the user sees when deciding whether to turn it on. */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Phawx"
      VALUE "FileDescription", "Example device"
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "example"
      VALUE "OriginalFilename", "example.dll"
      VALUE "ProductName", "Phawx ON example plugin"
      VALUE "ProductVersion", "1.0"
      /* Optional: a warning Phawx ON adds to the question it asks before turning
         the plugin on (at most 319 characters), for example:
      VALUE "PhawxWarning", "Uses the XYZ driver, which any program on this PC can use while the plugin runs."
      */
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

#include <winver.h>

/* FileDescription is the name Phawx ON shows for the plugin before it runs */
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Phawx"
      VALUE "FileDescription", "Legion Go"
      VALUE "PhawxWarning", "Sets the fan mode through Lenovo's firmware interface. Legion Space may change it back while it runs."
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "legiongo"
      VALUE "OriginalFilename", "legiongo.dll"
      VALUE "ProductName", "Phawx ON Legion Go plugin"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
